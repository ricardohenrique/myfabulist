            "body": {
              "mode": "raw",
              "raw": "{\n    \"lists\": \"detach\"\n}",
              "options": { "raw": { "language": "json" } },
              "disabled": true
            },
            "url": "{{base_url}}/api/v1/folders/{{folder_id}}",
            "description": "Deleting a non-empty folder without a 'lists' strategy ('detach' or 'delete') throws FolderNotEmptyException. Enable the body above and pick a strategy if the folder still has lists in it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
